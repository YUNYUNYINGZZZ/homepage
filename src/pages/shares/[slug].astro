---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rating from '../../components/Rating.astro';
import { SHARE_TYPE_META } from '../../lib/shares';

export async function getStaticPaths() {
  const items = await getCollection('shares');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const meta = SHARE_TYPE_META[item.data.type];
const dateStr = item.data.date.toISOString().slice(0, 10);
---
<BaseLayout title={item.data.title} description={item.data.summary}>
  <article>
    <header class="article-header">
      <span class="badge" style={`background:${meta.color}`}>{meta.label}</span>
      <h1>{item.data.title}</h1>
      <div class="media-meta">
        <span>{item.data.creator}</span>
        {item.data.year && <span>{item.data.year}</span>}
        {item.data.genre && <span>{item.data.genre}</span>}
        <Rating rating={item.data.rating} />
        <time datetime={dateStr}>{dateStr}</time>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
