---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { SHARE_TYPE_META } from '../lib/shares';

const thoughts = await getCollection('thoughts');
const skills = await getCollection('skills');
const shares = await getCollection('shares');

const latest = [
  ...thoughts.map((p) => ({
    href: `/thoughts/${p.id}/`,
    title: p.data.title,
    excerpt: p.data.description,
    date: p.data.date,
    tag: '随想',
  })),
  ...skills.map((p) => ({
    href: `/skills/${p.id}/`,
    title: p.data.title,
    excerpt: p.data.description,
    date: p.data.date,
    tag: `技能 · ${p.data.status}`,
  })),
  ...shares.map((p) => ({
    href: `/shares/${p.id}/`,
    title: p.data.title,
    excerpt: p.data.summary,
    date: p.data.date,
    tag: SHARE_TYPE_META[p.data.type].label,
  })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 6);
---
<BaseLayout>
  <section class="hero-full">
    <div class="hero-inner">
      <h1 class="hero-title">{SITE_TITLE}</h1>
      <p class="hero-sub">{SITE_DESCRIPTION}</p>
    </div>
    <a class="hero-scroll" href="#content">
      <span>向下滚动</span>
      <span class="chevron" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
      </span>
    </a>
  </section>

  <div id="content">
    <h2>最新动态</h2>
    <ul class="latest">
      {latest.map((item) => (
        <li class="latest-item">
          <a href={item.href}>
            <div class="latest-main">
              <span class="latest-title">
                {item.title}
                <span class="latest-tag"> · {item.tag}</span>
              </span>
              <span class="latest-excerpt">{item.excerpt}</span>
            </div>
            <time datetime={item.date.toISOString().slice(0, 10)}>
              {item.date.toISOString().slice(0, 10)}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
